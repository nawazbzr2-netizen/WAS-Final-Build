<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:theme="@style/ThemeOverlay.Material3.Toolbar.Surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/s_role" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/role_sender" />

                <RadioButton
                    android:id="@+id/rbReceiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/role_receiver" />
            </RadioGroup>

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/s_pin" />

            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pin_label"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="8" />

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/s_channels" />

            <RadioGroup
                android:id="@+id/rgChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ch_mono" />

                <RadioButton
                    android:id="@+id/rbStereo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ch_stereo" />
            </RadioGroup>

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/s_latency" />

            <RadioGroup
                android:id="@+id/rgLatency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbLow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lat_low" />

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lat_normal" />

                <RadioButton
                    android:id="@+id/rbSafe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lat_safe" />
            </RadioGroup>

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/s_manual_ip" />

            <EditText
                android:id="@+id/etManualIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/manual_ip_hint"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLength="15" />

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/s_language" />

            <RadioGroup
                android:id="@+id/rgLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbLangSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_system" />

                <RadioButton
                    android:id="@+id/rbLangEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_en" />

                <RadioButton
                    android:id="@+id/rbLangUr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_ur" />
            </RadioGroup>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btn_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
